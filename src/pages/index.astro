---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

// Content Modules
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import LabArchive from '../components/LabArchive.astro';
import Coursework from '../components/Coursework.astro';
import Education from '../components/Education.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
---

<Layout>
  {/* The main wrapper is now full-width, no padding */}
  <main class="w-full relative z-10 flex flex-col">

    {/* ========================================== */}
    {/* ZONE 1: DARK (Top Bookend)                 */}
    {/* ========================================== */}
    <div class="max-w-6xl mx-auto px-6 lg:pr-32 py-12 md:py-20 w-full">
      <Hero />
    </div>

    {/* ========================================== */}
    {/* ZONE 2: LIGHT (The Core Content)           */}
    {/* ========================================== */}
    {/* The outer div paints the full-bleed background, flips tokens, and applies the master grid */}
    <div class="zone-light bg-surface bg-grid w-full py-20 border-y border-[var(--color-border-subtle)] shadow-[0_0_30px_rgba(0,0,0,0.5)] relative">
      
      {/* The inner div snaps the content back to your 6xl grid */}
      <div class="max-w-6xl mx-auto px-6 lg:pr-32 w-full flex flex-col gap-24 md:gap-32 relative z-10">
        <Projects />
        <LabArchive />
        <Coursework />
        <Education />
        <Experience />
      </div>

    </div>

    {/* ========================================== */}
    {/* ZONE 3: DARK (Bottom Bookend)              */}
    {/* ========================================== */}
    <div class="max-w-6xl mx-auto px-6 lg:pr-32 py-16 md:py-24 w-full">
      <About />
    </div>

  </main>
</Layout>