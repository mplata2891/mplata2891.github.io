---
// src/components/system/SysCarousel.astro

const mobileBtn = [
  "sm:hidden absolute z-10 top-1/2 -translate-y-1/2", 
  "px-2 py-6 bg-void/90 border border-[var(--color-border-subtle)] text-secondary-color",
  "hover:text-accent hover:border-accent backdrop-blur-sm transition-all"
].join(" ");

const desktopBtn = [
  "font-special-ui text-sm text-secondary-color hover:text-accent",
  "transition-colors"
].join(" ");
---

<sys-carousel class="flex flex-col w-full group/carousel relative">
  
  {/* 1. TRACK WRAPPER (For Mobile Arrows) */}
  <div class="relative w-full flex items-center">
    
    {/* Mobile Prev Arrow */}
    <button class:list={[mobileBtn, "left-0 border-l-0 prev-btn"]}>
      &lt;
    </button>

    <div class:list={[
      "carousel-track flex overflow-x-auto snap-x snap-mandatory gap-6",
      "pb-4 hide-scrollbar items-stretch w-full scroll-smooth"
    ]}>
      <slot />
    </div>

    {/* Mobile Next Arrow */}
    <button class:list={[mobileBtn, "right-0 border-r-0 next-btn"]}>
      &gt;
    </button>
  </div>

  {/* 2. CENTERED DESKTOP CONTROLS */}
  <div class:list={[
    "hidden sm:flex justify-center items-center mt-2 pt-4 border-t",
    "border-[var(--color-border-subtle)]"
  ]}>
    <div class="nav-buttons flex items-center gap-8">
      <button class:list={[desktopBtn, "prev-btn"]}>
        [ &lt;_PREV ]
      </button>
      
      {/* Position Counter (Milspec Telemetry Style) */}
      <div class="font-special-ui text-sm text-secondary-color tracking-widest select-none">
        <span class="carousel-current">01</span> / <span class="carousel-total">--</span>
      </div>

      <button class:list={[desktopBtn, "next-btn"]}>
        [ NEXT_&gt; ]
      </button>
    </div>
  </div>

</sys-carousel>

{/* --- CSS: SCROLLBARS --- */}
<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

{/* --- JS: TARGET-BASED INFINITE LOGIC --- */}
<script>
  class SysCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.carousel-track');
      this.items = Array.from(this.track.children);
      this.prevBtns = this.querySelectorAll('.prev-btn');
      this.nextBtns = this.querySelectorAll('.next-btn');
      this.currentSpan = this.querySelector('.carousel-current');
      this.totalSpan = this.querySelector('.carousel-total');

      if (this.items.length === 0) return;

      // 1. Initialize Telemetry Data
      this.totalSpan.textContent = this.items.length.toString().padStart(2, '0');
      this.currentIndex = 0;

      // 2. Setup Radar (Intersection Observer)
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            this.currentIndex = this.items.indexOf(entry.target);
            if (this.currentSpan) {
              this.currentSpan.textContent = (this.currentIndex + 1).toString().padStart(2, '0');
            }
          }
        });
      }, {
        root: this.track,
        threshold: 0.5
      });

      this.items.forEach(item => observer.observe(item));

      // 3. Attach Navigation Engines (Using exact indexing)
      this.nextBtns.forEach(btn => btn.addEventListener('click', () => this.goTo(this.currentIndex + 1)));
      this.prevBtns.forEach(btn => btn.addEventListener('click', () => this.goTo(this.currentIndex - 1)));
    }

    goTo(targetIndex) {
      // The "Infinite Loop" Math
      if (targetIndex >= this.items.length) {
        targetIndex = 0; // If you hit next on the last card, rewind to start
      } else if (targetIndex < 0) {
        targetIndex = this.items.length - 1; // If you hit prev on the first card, jump to end
      }

      const targetItem = this.items[targetIndex];
      
      // Calculate exact pixel destination relative to the track's current position
      const trackRect = this.track.getBoundingClientRect();
      const itemRect = targetItem.getBoundingClientRect();
      const scrollPosition = this.track.scrollLeft + (itemRect.left - trackRect.left);

      this.track.scrollTo({
        left: scrollPosition,
        behavior: 'smooth'
      });
    }
  }

  if (!customElements.get('sys-carousel')) {
    customElements.define('sys-carousel', SysCarousel);
  }
</script>