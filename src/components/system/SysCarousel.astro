---
// src/components/system/SysCarousel.astro

const mobileBtn = [
  "prev-btn sm:hidden absolute z-10 top-1/2 -translate-y-1/2",
  "px-2 py-6 bg-void/90 border border-[var(--color-border-subtle)] text-secondary-color",
  "hover:text-accent hover:border-accent backdrop-blur-sm transition-all"
].join(" ");

const desktopBtn = [
  "font-special-ui text-sm text-secondary-color hover:text-accent",
  "transition-colors"
].join(" ");
---

<sys-carousel class="flex flex-col w-full group/carousel relative">
  
  {/* 1. TRACK WRAPPER (For Mobile Arrows) */}
  <div class="relative w-full flex items-center">
    
    {/* Mobile Prev Arrow */}
    <button class:list={[mobileBtn, "left-0 border-l-0 prev-btn"]}>
      &lt;
    </button>

    <div class:list={[
      "carousel-track flex overflow-x-auto snap-x snap-mandatory gap-6",
      "pb-4 hide-scrollbar items-stretch w-full"
    ]}>
      <slot />
    </div>

    {/* Mobile Next Arrow */}
    <button class:list={[mobileBtn, "right-0 border-r-0 next-btn"]}>
      &gt;
    </button>
  </div>

  {/* 2. CENTERED DESKTOP CONTROLS */}
  <div class:list={[
    "hidden sm:flex justify-center items-center mt-2 pt-4 border-t",
    "border-[var(--color-border-subtle)]"
  ]}>
    {/* Swapped gap-12 to gap-8 and added items-center to align the new counter */}
    <div class="nav-buttons flex items-center gap-8">
      <button class:list={[desktopBtn, "prev-btn"]}>
        [ &lt;_PREV ]
      </button>
      
      {/* PHASE 04: Position Counter (Milspec Telemetry Style) */}
      <div class="font-special-ui text-sm text-secondary-color tracking-widest select-none">
        <span class="carousel-current">01</span> / <span class="carousel-total">--</span>
      </div>

      <button class:list={[desktopBtn, "next-btn"]}>
        [ NEXT_&gt; ]
      </button>
    </div>
  </div>

</sys-carousel>

{/* --- CSS: SCROLLBARS --- */}
<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

{/* --- JS: BIDIRECTIONAL INFINITE CAROUSEL LOGIC --- */}
<script>
  import { initSysCarousel } from '../../scripts/scroll_carousel.js';

  class SysCarousel extends HTMLElement {
    connectedCallback() {
      initSysCarousel(this); 
    }
  }

  if (!customElements.get('sys-carousel')) {
    customElements.define('sys-carousel', SysCarousel);
  }
</script>