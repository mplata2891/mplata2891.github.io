---
// src/components/global/Header.astro
import SocialIcon from '../icons/SocialIcons.astro';
import { HEADER } from '../../data/header.js';

const iconLinkStyle = [
  "text-primary-color opacity-40 group-hover:text-accent-bright group-hover:opacity-100", 
  "transition-all duration-300 w-5 h-5 block"
].join(" ");

const linkStyle = [
  "font-section-description text-base font-medium text-primary-color", 
  "hover:text-accent-bright transition-colors duration-300", 
  "flex items-center gap-2 group" 
].join(" ");

const buttonStyle = [
  "px-6 py-2 border border-accent/50 font-special-ui text-[11px]",
  "bg-transparent text-primary-color uppercase tracking-[0.15em] font-bold",
  "hover:bg-accent transition-all duration-300", 
  "rounded-none shadow-[0_0_10px_transparent] hover:shadow-[0_0_15px_var(--color-accent-glow-strong)]" 
].join(" ");

const desktopNav = "hidden md:flex items-center gap-10";
---

<header class:list={[
  "w-full px-10 py-3 flex justify-between items-center",
  "border-b border-[var(--color-border-subtle)] bg-void/90 backdrop-blur-xl z-50 sticky top-0"
]}>
  
  {/* SYSTEM IDENTITY: Bold and Structural */}
  <div class="flex items-center gap-6 group cursor-pointer">
    <span class="font-section-description text-xl text-primary-color font-bold tracking-tight">
      {HEADER.initials}
    </span>
    
    <div class="h-5 w-[1px] bg-white/10 hidden md:block"></div>
    
    <span class="font-special-ui text-[10px] tracking-[0.2em] text-secondary-color uppercase mt-0.5">
      {HEADER.systemName}
    </span>
  </div>

  {/* DESKTOP NAV: Legible & Clean */}
  <nav class={desktopNav}>
    {HEADER.navLinks.map((link) => (
      <a href={link.url} target="_blank" class={linkStyle}>
        
        {/* Interactive glitch effect on hover */}
        <span class="glitch-hover">{link.label}</span>
        
        {/* Bulletproof checks: ignores spaces and exact casing */}
        {link.label.toLowerCase().trim().includes('github') && (
          <SocialIcon name="github" class={iconLinkStyle} />
        )}
        
        {link.label.toLowerCase().trim().includes('linkedin') && (
          <SocialIcon name="linkedin" class={iconLinkStyle} />
        )}
      </a>
    ))}
    <a href={HEADER.actionButton.url} target="_blank" class={buttonStyle}>
      {HEADER.actionButton.label}
    </a>
  </nav>

  {/* MOBILE HAMBURGER */}
  <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5">
    <div class="w-6 h-[2px] bg-primary-color"></div>
    <div class="w-6 h-[2px] bg-primary-color"></div>
  </button>
</header>