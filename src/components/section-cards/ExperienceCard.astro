---
// src/components/section-cards/ExperienceCard.astro
const { job } = Astro.props;
---

<article class:list={[
  "border-2 border-secondary-color bg-surface p-8 relative group transition-all duration-300",
  "shadow-[6px_6px_0px_var(--color-secondary-color)] hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[10px_10px_0px_var(--color-secondary-color)]",
  "overflow-hidden h-full flex flex-col"
]}>
  
  <div class="relative z-10 flex flex-col md:flex-row gap-8 pl-2">
    
    <div class="md:w-1/3 flex flex-col gap-4">
      
      <div class="flex items-center gap-2">
        {job.statusNode === '[ ACTIVE_NODE ]' && (
          <span class="w-2 h-2 rounded-none bg-accent animate-pulse shadow-[0_0_8px_var(--color-accent)]"></span>
        )}
        <p class:list={[
          "font-special-ui text-sm tracking-widest uppercase mt-0.5",
          job.statusNode === '[ ACTIVE_NODE ]' ? 'text-primary-color font-bold' : 'text-secondary-color'
        ]}>
          {job.statusNode}
        </p>
      </div>
      
      <div>
        <h3 class="text-xl font-section-headers text-primary-color uppercase tracking-wide">
          {job.company}
        </h3>
        <p class="font-special-ui text-sm text-secondary-color uppercase mt-1 tracking-widest">
          // LOC: {job.location}
        </p>
      </div>
      
      <div>
        <p class="font-special-ui text-sm text-secondary-color uppercase tracking-widest">
          {job.dates}
        </p>
        
        <p class="font-special-ui text-xs text-secondary-color bg-void px-2 py-1 inline-block mt-2 border border-[var(--color-border-subtle)] uppercase tracking-widest">
          Uptime: {job.uptime}
        </p>
      </div>
      
      <div class="flex flex-wrap gap-2 mt-2">
        {job.tags.map((tag) => (
          <span class="px-2 py-1 bg-void border border-[var(--color-border-subtle)] text-xs font-special-ui text-secondary-color uppercase tracking-widest">
            #{tag}
          </span>
        ))}
      </div>
    </div>

    <div class="md:w-2/3 md:border-l border-[var(--color-border-subtle)] md:pl-8">
      
      <h4 class="text-lg md:text-xl font-section-headers mb-6 text-primary-color uppercase tracking-wide">
        {job.title}
      </h4>

      {job.bridgeSentence && (
        <div class="mb-6 p-4 bg-acrnm-blk border border-[var(--color-border-subtle)] border-l-2 border-l-secondary-color">
          <p class="font-special-ui text-xs text-surface/60 mb-1 tracking-widest">
            // OPERATOR_CONTEXT
          </p>
          <p class="font-section-body text-sm text-surface leading-relaxed italic">
            {job.bridgeSentence}
          </p>
        </div>
      )}
      
      <ul class="flex flex-col gap-4 deploy-stagger">
        {job.responsibilities.map((task) => (
          <li class="flex items-start gap-3 group/item deploy-hidden">
            <span class="font-special-ui text-secondary-color mt-0.5 transition-colors group-hover/item:text-primary-color">
              >>
            </span>
            <p class="font-section-body text-sm text-primary-color leading-relaxed">
              {task}
            </p>
          </li>
        ))}
      </ul>
      
    </div>

  </div>
</article>