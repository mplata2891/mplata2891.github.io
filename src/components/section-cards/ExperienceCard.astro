---
// src/components/section-cards/ExperienceCard.astro
const { job } = Astro.props;

// Generate a unique ID to ensure scoped JS if there are multiple jobs at the same company
const cardId = `exp-card-${job.company.replace(/\s+/g, '-').toLowerCase()}-${Math.random().toString(36).substr(2, 9)}`;
---

<article id={cardId} class:list={[
  "js-experience-card border-2 border-secondary-color bg-surface relative group transition-all duration-300",
  "shadow-[6px_6px_0px_var(--color-secondary-color)] hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[10px_10px_0px_var(--color-secondary-color)]",
  "overflow-hidden h-full flex flex-col"
]}>

  {/* ========================================== */}
  {/* MOBILE HUD TABS (Hidden on Desktop)        */}
  {/* ========================================== */}
  <div class="flex border-b border-[var(--color-border-subtle)] bg-[#121212] md:hidden">
    <button 
      class="hud-tab active flex-1 py-3 font-special-ui text-[10px] sm:text-xs tracking-widest uppercase transition-colors border-b-2 border-accent text-accent"
      data-target="org"
    >
      [ ORG ]
    </button>
    <button 
      class="hud-tab flex-1 py-3 font-special-ui text-[10px] sm:text-xs tracking-widest uppercase transition-colors border-b-2 border-transparent text-secondary-color hover:text-primary-color"
      data-target="role"
    >
      [ ROLE ]
    </button>
    <button 
      class="hud-tab flex-1 py-3 font-special-ui text-[10px] sm:text-xs tracking-widest uppercase transition-colors border-b-2 border-transparent text-secondary-color hover:text-primary-color"
      data-target="tasks"
    >
      [ TASKS ]
    </button>
  </div>

  {/* ========================================== */}
  {/* CARD BODY (Padded Container)               */}
  {/* ========================================== */}
  <div class="p-6 md:p-8 relative z-10 flex flex-col md:flex-row gap-8 flex-grow">
    
    {/* ========================================== */}
    {/* LEFT COLUMN: ORG METADATA                  */}
    {/* ========================================== */}
    <div class="hud-panel active-panel md:w-1/3 flex flex-col gap-4" data-panel="org">
      
      <div class="flex items-center gap-2">
        {job.statusNode === '[ ACTIVE_NODE ]' && (
          <span class="w-2 h-2 rounded-none bg-accent animate-pulse shadow-[0_0_8px_var(--color-accent)]"></span>
        )}
        <p class:list={[
          "font-special-ui text-sm tracking-widest uppercase mt-0.5",
          job.statusNode === '[ ACTIVE_NODE ]' ? 'text-primary-color font-bold' : 'text-secondary-color'
        ]}>
          {job.statusNode}
        </p>
      </div>
      
      <div>
        <h3 class="text-xl font-section-headers text-primary-color uppercase tracking-wide">
          {job.company}
        </h3>
        <p class="font-special-ui text-sm text-secondary-color uppercase mt-1 tracking-widest">
          // LOC: {job.location}
        </p>
      </div>
      
      <div>
        <p class="font-special-ui text-sm text-secondary-color uppercase tracking-widest">
          {job.dates}
        </p>
        
        <p class="font-special-ui text-xs text-secondary-color bg-void px-2 py-1 inline-block mt-2 border border-[var(--color-border-subtle)] uppercase tracking-widest">
          Uptime: {job.uptime}
        </p>
      </div>
      
      <div class="flex flex-wrap gap-2 mt-2">
        {job.tags.map((tag) => (
          <span class="px-2 py-1 bg-void border border-[var(--color-border-subtle)] text-xs font-special-ui text-secondary-color uppercase tracking-widest">
            #{tag}
          </span>
        ))}
      </div>
    </div>

    {/* ========================================== */}
    {/* RIGHT COLUMN: ROLE & TASKS                 */}
    {/* ========================================== */}
    <div class="md:w-2/3 md:border-l border-[var(--color-border-subtle)] md:pl-8 flex flex-col">
      
      {/* ZONE 2: ROLE (Title & Context) */}
      <div class="hud-panel flex flex-col" data-panel="role">
        <h4 class="text-lg md:text-xl font-section-headers text-primary-color uppercase tracking-wide">
          {job.title}
        </h4>

        {job.bridgeSentence && (
          <div class="mt-6 p-4 bg-acrnm-blk border border-[var(--color-border-subtle)] border-l-2 border-l-secondary-color">
            <p class="font-special-ui text-xs text-surface/60 mb-1 tracking-widest">
              // OPERATOR_CONTEXT
            </p>
            <p class="font-section-body text-sm text-surface leading-relaxed italic">
              {job.bridgeSentence}
            </p>
          </div>
        )}
      </div>

      {/* ZONE 3: TASKS (Responsibilities) */}
      {/* md:mt-6 creates the gap between Context and Tasks ONLY on desktop */}
      <div class="hud-panel flex flex-col mt-0 md:mt-6" data-panel="tasks">
        <ul class="flex flex-col gap-4 deploy-stagger">
          {job.responsibilities.map((task) => (
            <li class="flex items-start gap-3 group/item deploy-hidden">
              <span class="font-special-ui text-secondary-color mt-0.5 transition-colors group-hover/item:text-primary-color">
                >>
              </span>
              <p class="font-section-body text-sm text-primary-color leading-relaxed">
                {task}
              </p>
            </li>
          ))}
        </ul>
      </div>
      
    </div>

  </div>
</article>

{/* ========================================== */}
{/* SYSTEM LOGIC & RESPONSIVE HIDING           */}
{/* ========================================== */}
<style>
  /* Below Tailwind 'md' (768px), hide inactive panels. Above it, natural grid takes over. */
  @media (max-width: 767px) {
    .hud-panel:not(.active-panel) {
      display: none !important;
    }
  }
</style>

<script>
  function initExperienceCards() {
    const cards = document.querySelectorAll('.js-experience-card');

    cards.forEach(card => {
      const tabs = card.querySelectorAll('.hud-tab');
      const panels = card.querySelectorAll('.hud-panel');

      tabs.forEach(tab => {
        tab.onclick = () => {
          const target = tab.getAttribute('data-target');

          // Reset all tabs
          tabs.forEach(t => {
            t.classList.remove('border-accent', 'text-accent');
            t.classList.add('border-transparent', 'text-secondary-color');
          });

          // Highlight clicked tab
          tab.classList.remove('border-transparent', 'text-secondary-color');
          tab.classList.add('border-accent', 'text-accent');

          // Swap visible panels
          panels.forEach(p => {
            if (p.getAttribute('data-panel') === target) {
              p.classList.add('active-panel');
            } else {
              p.classList.remove('active-panel');
            }
          });
        };
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initExperienceCards);
  document.addEventListener('astro:page-load', initExperienceCards);
</script>