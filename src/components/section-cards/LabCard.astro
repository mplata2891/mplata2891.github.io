---
// src/components/section-cards/LabCard.astro
import { Code } from 'astro:components';

const { lab } = Astro.props;
const modalId = `modal-${lab.id}`;
const cardId = `lab-card-${lab.id}`;

// Safely compute the slug up here to avoid JSX regex parsing errors
const courseSlug = lab.courseName ? lab.courseName.replace(/\s+/g, '_').toLowerCase() : 'lab';
---

{/* OUTER WRAPPER: Added js-lab-card for the global script to find */}
<article id={cardId} class:list={[
  "js-lab-card",
  "border-2 border-secondary-color flex flex-col relative h-full group bg-surface",
  "shadow-[6px_6px_0px_var(--color-secondary-color)] transition-all duration-300",
  "hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[10px_10px_0px_var(--color-secondary-color)]"
]}>
  
  {/* ========================================== */}
  {/* ZONE 1: HEADER (Jet Black Hardware Fill)   */}
  {/* ========================================== */}
  <div class="bg-acrnm-blk border-b border-[var(--color-border-subtle)] p-6 flex flex-col md:flex-row md:justify-between md:items-start gap-4 border-l-4 border-l-industrial relative">
    
    <div class="absolute top-0 left-0 right-0 h-[3px] bg-acrnm-blk"></div>

    <div class="relative z-10">
      <div class="flex items-center gap-3 mb-2">
        <span class="font-special-ui text-sm text-surface">[{lab.id}]</span>
        <span class="font-special-ui text-xs uppercase px-2 py-0.5 border border-accent text-accent">
          TYPE: {lab.type}
        </span>
      </div>
      <h3 class="text-2xl font-section-headers tracking-wide text-surface mb-1 uppercase">{lab.courseName}</h3>
      <p class="font-special-ui text-sm text-surface/60 uppercase">// INSTRUCTOR: {lab.professor}</p>
    </div>
    
    <div class="flex flex-wrap gap-2 md:max-w-xs justify-start md:justify-end relative z-10">
      {lab.tags && lab.tags.map((tag) => (
        <span class="font-special-ui text-xs text-surface bg-white/5 px-2 py-1 border border-surface/20">
          #{tag}
        </span>
      ))}
    </div>
  </div>

  {/* ========================================== */}
  {/* ZONE 1.5: MOBILE HUD TABS (Hidden on Desktop) */}
  {/* ========================================== */}
  <div class="flex border-b border-[var(--color-border-subtle)] bg-[#121212] lg:hidden">
    <button 
      class="hud-tab active flex-1 py-3 font-special-ui text-xs tracking-widest uppercase transition-colors border-b-2 border-accent text-accent"
      data-target="brief"
    >
      [ OBJECTIVE_BRIEF ]
    </button>
    <button 
      class="hud-tab flex-1 py-3 font-special-ui text-xs tracking-widest uppercase transition-colors border-b-2 border-transparent text-secondary-color hover:text-primary-color"
      data-target="tech"
    >
      [ TECHNICAL_DATA ]
    </button>
  </div>

  {/* ========================================== */}
  {/* ZONE 2: BODY (Light Surface)               */}
  {/* ========================================== */}
  <div class="bg-surface p-6 grid grid-cols-1 lg:grid-cols-2 gap-8 flex-grow">
    
    {/* LEFT COLUMN: Text Content (MISSION_BRIEF) */}
    <div class="hud-panel flex flex-col gap-6 active-panel" data-panel="brief">
      <div>
        <h4 class="font-section-description tracking-widest text-sm text-secondary-color mb-2 uppercase">// THE_PROBLEM</h4>
        <p class="font-section-body text-primary-color leading-relaxed text-sm">{lab.problem}</p>
      </div>
      <div>
        <h4 class="font-section-description tracking-widest text-sm text-secondary-color mb-2 uppercase">// THE_SOLUTION</h4>
        <p class="font-section-body text-primary-color leading-relaxed text-sm">{lab.solution}</p>
      </div>
    </div>

    {/* RIGHT COLUMN: The Terminal Inset (TECHNICAL_DATA) */}
    <div class="hud-panel flex flex-col h-full" data-panel="tech">
      
      {/* SOFTWARE RENDER */}
      {lab.type === 'software' && (
        <div class="bg-acrnm-blk border border-[var(--color-border-subtle)] p-0 w-full flex flex-col h-full group/terminal">
          
          <div class="flex justify-between items-center px-4 py-2 border-b border-[var(--color-border-subtle)] bg-[#121212]">
            <p class="font-special-ui text-xs text-secondary-color uppercase">
              {lab.primaryLanguage} | <a href={lab.repoUrl} target="_blank" rel="noopener noreferrer" class="text-secondary-color hover:text-accent transition-colors">view_repo</a>
            </p>
            <div class="flex gap-2">
              <div class="w-2 h-2 rounded-none bg-industrial"></div>
              <div class="w-2 h-2 rounded-none bg-industrial"></div>
            </div>
          </div>
          
          <div class="p-4 bg-acrnm-blk h-64 overflow-y-auto lab-scrollbar">
            <div class="font-special-ui text-xs [&>pre]:!bg-transparent [&>pre]:whitespace-pre-wrap">
              <Code code={lab.codeSnippet} lang={lab.primaryLanguage} theme="dracula" />
            </div>
          </div>

          {lab.fullCode && (
            <button 
              onclick={`document.getElementById('${modalId}').showModal()`}
              class="w-full mt-auto py-3 border-t border-[var(--color-border-subtle)] bg-[#121212] hover:bg-accent/10 transition-colors font-special-ui text-xs text-accent text-center uppercase tracking-widest flex justify-center items-center gap-2 group/btn"
            >
              <span>>> EXPAND_FULL_CODE</span>
              <span class="w-2 h-4 bg-accent animate-blink opacity-0 group-hover/btn:opacity-100"></span>
            </button>
          )}
        </div>
      )}

      {/* HARDWARE RENDER */}
      {lab.type === 'hardware' && (
        <div class="bg-surface border border-[var(--color-border-subtle)] p-2 w-full flex flex-col h-full relative overflow-hidden">
            <img 
              src={lab.schematicAsset} 
              alt={`Schematic for ${lab.courseName}`}
              class="w-full h-auto object-cover grayscale mix-blend-luminosity hover:grayscale-0 transition-all duration-500"
            />
          
          <div class="flex flex-wrap gap-2 mt-auto p-2 bg-surface border-t border-[var(--color-border-subtle)]">
            <span class="font-special-ui text-xs text-secondary-color uppercase">SPECS:</span>
            {lab.hardwareSpecs && lab.hardwareSpecs.map((spec) => (
              <span class="font-special-ui text-xs text-primary-color border border-[var(--color-border-subtle)] px-2 py-0.5">
                {spec}
              </span>
            ))}
          </div>
        </div>
      )}

      {/* RESEARCH RENDER */}
      {lab.type === 'research' && (
        <div class="bg-acrnm-blk border border-[var(--color-border-subtle)] p-0 w-full flex flex-col h-full">
          
          <div class="flex justify-between items-center px-4 py-2 border-b border-[var(--color-border-subtle)] bg-[#121212]">
            <p class="font-special-ui text-xs text-secondary-color uppercase tracking-widest">
              // ATTACHED_ASSETS
            </p>
            <p class="font-special-ui text-xs text-secondary-color uppercase">
              ROLE: {lab.role}
            </p>
          </div>

          <div class="flex flex-col gap-0 flex-grow">
            {lab.attachedAssets && lab.attachedAssets.map((asset) => (
              <a 
                href={asset.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between px-4 py-3 border-b border-[var(--color-border-subtle)] hover:bg-accent/10 transition-colors group/asset"
              >
                <div class="flex flex-col gap-0.5">
                  <span class="font-special-ui text-xs text-accent uppercase tracking-widest">
                    {asset.type}
                  </span>
                  <span class="font-special-ui text-xs text-surface/80">
                    {asset.label}
                  </span>
                </div>
                <span class="font-special-ui text-xs text-secondary-color group-hover/asset:text-accent transition-colors">
                  >> OPEN
                </span>
              </a>
            ))}
          </div>

          {lab.repoUrl && (
            <a 
              href={lab.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-auto py-3 border-t border-[var(--color-border-subtle)] bg-[#121212] hover:bg-accent/10 transition-colors font-special-ui text-xs text-accent text-center uppercase tracking-widest flex justify-center items-center gap-2 group/btn"
            >
              <span>>> VIEW_TEAM_REPO</span>
              <span class="w-2 h-4 bg-accent animate-blink opacity-0 group-hover/btn:opacity-100"></span>
            </a>
          )}
        </div>
      )}
    </div>
  </div>

  {/* --- TRUE GLASSMORPHIC MODAL --- */}
  {lab.type === 'software' && lab.fullCode && (
    <dialog 
      id={modalId} 
      class="fixed inset-0 m-auto w-11/12 max-w-5xl bg-void/40 backdrop-blur-2xl border border-white/10 border-t-2 border-t-accent rounded-none shadow-[0_8px_32px_rgba(0,0,0,0.5)] text-primary-color backdrop:bg-black/80 backdrop:backdrop-blur-sm p-0 overflow-hidden"
    >
      <div class="flex justify-between items-center px-4 py-3 border-b border-white/10 bg-[#121212]/90 z-10">
        <div class="flex items-center gap-4">
          <div class="flex gap-1.5 items-center">
            <div class="w-2 h-2 rounded-none bg-industrial"></div>
            <div class="w-2 h-2 rounded-none bg-industrial"></div>
            <div class="status-dot status-dot--accent ml-1"></div>
          </div>
          <p class="font-special-ui text-xs text-surface/80 mt-0.5 uppercase tracking-widest">
            {"~/" + courseSlug + "/main." + lab.primaryLanguage}
          </p>
        </div>
        
        <form method="dialog">
          <button class="font-special-ui text-xs text-critical hover:text-void transition-colors px-2 py-1 border border-transparent hover:border-critical bg-transparent hover:bg-critical focus:outline-none">
            [ ESC ] CLOSE
          </button>
        </form>
      </div>
      
      <div class="p-6 overflow-y-auto max-h-[75vh] bg-acrnm-blk/95 lab-scrollbar">
        <div class="font-special-ui text-sm [&>pre]:!bg-transparent">
          <Code code={lab.fullCode} lang={lab.primaryLanguage} theme="dracula" />
        </div>
      </div>
    </dialog>
  )}
</article>

{/* ========================================== */}
{/* THE LOGIC & CSS (Bulletproof isolation)    */}
{/* ========================================== */}
<style>
  /* Mobile Only: Hides the inactive panel so they toggle instead of stack */
  @media (max-width: 1023px) {
    .hud-panel:not(.active-panel) {
      display: none !important;
    }
  }

  .lab-scrollbar::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  .lab-scrollbar::-webkit-scrollbar-track {
    background: #0a0a0a; 
    border-left: 1px solid rgba(255, 255, 255, 0.05);
  }
  .lab-scrollbar::-webkit-scrollbar-thumb {
    background: #465464; 
  }
  .lab-scrollbar::-webkit-scrollbar-thumb:hover {
    background: var(--color-accent); 
  }
</style>

<script>
  // This runs exactly ONCE, finding all cards and attaching the logic safely.
  function initLabCards() {
    // Find every Lab Card on the page using the js-lab-card class
    const cards = document.querySelectorAll('.js-lab-card');
    
    cards.forEach(card => {
      const tabs = card.querySelectorAll('.hud-tab');
      const panels = card.querySelectorAll('.hud-panel');

      tabs.forEach(tab => {
        // Use standard onclick to prevent duplicate fires during Astro transitions
        tab.onclick = () => {
          const target = tab.getAttribute('data-target');

          // 1. Reset all tabs within THIS specific card
          tabs.forEach(t => {
            t.classList.remove('border-accent', 'text-accent');
            t.classList.add('border-transparent', 'text-secondary-color');
          });

          // 2. Highlight clicked tab
          tab.classList.remove('border-transparent', 'text-secondary-color');
          tab.classList.add('border-accent', 'text-accent');

          // 3. Toggle panels within THIS specific card
          panels.forEach(p => {
            if (p.getAttribute('data-panel') === target) {
              p.classList.add('active-panel');
            } else {
              p.classList.remove('active-panel');
            }
          });
        };
      });
    });
  }

  // Run on initial page paint
  document.addEventListener('DOMContentLoaded', initLabCards);
  
  // Run on any subsequent Astro page navigations
  document.addEventListener('astro:page-load', initLabCards);
</script>