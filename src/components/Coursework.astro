---
// src/components/Coursework.astro
import { COURSEWORK, COURSEWORK_DESCRIPTION } from '../data/coursework.js';
import HardwareNode from './ui/HardwareNode.astro';
---

<section id="coursework" class="flex flex-col w-full scroll-mt-24 mb-16 deploy-hidden">

  {/* SECTION HEADER */}
  <div class="flex items-center mb-4 w-full">
    
    <div class="relative flex items-center">
      <div class="trace-connector hidden lg:block z-0"></div>
      <HardwareNode class="text-secondary-color hidden lg:block relative z-10 mr-4 bg-void" />
      
      <h2 class="text-4xl font-section-headers tracking-tight uppercase text-primary-color">
        THEORY_LOGS
      </h2>
    </div>

    <div class="h-[1px] flex-grow bg-[var(--color-border-subtle)] ml-4"></div>
    <p class="font-special-ui text-sm text-secondary-color uppercase ml-4">
      INSTRUCTION_SET_V3.0
    </p>
    
  </div>

  {/* DYNAMIC CONTEXT PARAGRAPH */}
  <p class="font-section-description text-secondary-color leading-relaxed tracking-wider mb-8 w-full">
    {COURSEWORK_DESCRIPTION}
  </p>

  {/* THE DATA GRID */}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {COURSEWORK.map((section) => (
      <div class:list={[
        "border-2 border-secondary-color bg-surface p-6 relative group transition-all duration-300 overflow-hidden",
        "shadow-[6px_6px_0px_var(--color-secondary-color)] hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[10px_10px_0px_var(--color-secondary-color)]"
      ]}>
        
        {/* CLUSTER TITLE */}
        <h3 class="font-special-ui text-sm text-secondary-color mb-4 border-b border-[var(--color-border-subtle)] pb-3 relative z-10 uppercase tracking-widest">
          // {section.cluster}
        </h3>
        
        {/* COURSE LIST */}
        <ul class="flex flex-col relative z-10">
          {section.logs.map((log) => (
            <li class="flex items-start gap-3 group/item transition-colors px-2 py-1.5 -mx-2 hover:bg-secondary-color/10">
              
              <span class="font-special-ui text-secondary-color mt-0.5 text-xs">
                {">>"}
              </span>
              
              <span class="font-section-body text-sm text-primary-color leading-tight">
                {log}
              </span>
            </li>
          ))}
        </ul>

      </div>
    ))}
  </div>

</section>