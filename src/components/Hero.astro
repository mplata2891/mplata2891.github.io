---
// src/components/Hero.astro
import { IDENTITY } from '../data/identity.js';
---

<section id="hero" class="bg-void min-h-[60vh] flex flex-col justify-center mb-16 relative overflow-hidden">
  
  {/* ATMOSPHERIC FX: Rouge Mystique CRT scanlines (Dark Zone Only) */}
  <div class="absolute inset-0 crt-scanlines pointer-events-none"></div>
  
  <div class="relative z-10">
    {/* HARDWARE STATUS INDICATOR */}
    <div class="flex items-center gap-3 mb-4">
      <div class="status-dot status-dot--accent"></div>
      <p class="font-special-ui font-bold text-secondary-color text-sm tracking-[0.3em] uppercase">
        {IDENTITY.statusText}
      </p>
    </div>
    
    {/* MY NAME: Space Grotesk display font */}
    <h1 class="text-6xl md:text-8xl font-section-headers font-light mb-2 tracking-widest uppercase text-primary-color glitch-hover leading-none">
      {IDENTITY.name}
    </h1>
    
    {/* TITLE WITH BLINKING CURSOR */}
    <h2 class="text-sm md:text-base font-special-ui text-acrnm-grn tracking-[0.3em] mb-12 uppercase flex items-center">
      <span>{IDENTITY.title.replace('_', '')}</span>
      <span class="text-accent animate-blink font-bold ml-1">_</span>
    </h2>
    
    {/* BIO CONTAINER */}
    <div class="flex flex-col gap-4 max-w-2xl">
      
      {/* Primary Hook */}
      <p class="font-section-body font-medium text-primary-color text-2xl leading-relaxed tracking-wide">
        {IDENTITY.shortBio}
      </p>
      
      {/* Secondary Details */}
      {IDENTITY.fullBio.map((paragraph) => (
        <p class="font-section-body text-secondary-color text-xl leading-relaxed tracking-wide">
          {paragraph}
        </p>
      ))}

    </div>
  </div>
</section>