---
// src/components/Education.astro
import { EDUCATION, EDUCATION_DESCRIPTION } from '../data/education.js';
import HardwareNode from './ui/HardwareNode.astro';
---

<section id="education" class="flex flex-col w-full scroll-mt-24 mb-16 deploy-hidden">

  {/* SECTION HEADER */}
  <div class="flex items-center mb-4 w-full">
    
    <div class="relative flex items-center">
      <div class="trace-connector hidden lg:block z-0"></div>
      
      <HardwareNode class="text-secondary-color hidden lg:block relative z-10 mr-4 bg-void" />
      
      <h2 class="text-4xl font-section-headers tracking-tight uppercase text-primary-color"
        data-scramble 
        data-scramble-delay="400"
      >
        CREDENTIALS
      </h2>
    </div>

    <div class="h-[1px] flex-grow bg-[var(--color-border-subtle)] ml-4"></div>
    <p class="font-special-ui text-sm text-secondary-color uppercase ml-4">
      Base_Parameters_v2.0
    </p>
    
  </div>

  {/* DYNAMIC CONTEXT PARAGRAPH */}
  <p class="font-section-description text-secondary-color tracking-wider leading-relaxed mb-8 w-full">
    {EDUCATION_DESCRIPTION}
  </p>

  {/* THE DATA GRID */}
  <div class="flex flex-col gap-6">
    {EDUCATION.map((edu) => (
      <div class:list={[
        "border-2 border-secondary-color bg-surface p-6 relative group transition-all duration-300 overflow-hidden",
        "shadow-[6px_6px_0px_var(--color-secondary-color)] hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[10px_10px_0px_var(--color-secondary-color)]"
      ]}>

        <div class="flex flex-col md:flex-row justify-between md:items-start gap-4 mb-6">
          <div>
            <p class="font-special-ui text-[10px] text-secondary-color mb-1 tracking-widest">[{edu.id}]</p>
            
            {/* Degree Title */}
            {edu.degrees.map((degree) => (
              <h3 class="text-xl font-section-body tracking-widest text-primary-color group-hover:text-secondary-color transition-colors uppercase">
                {degree}
              </h3>
            ))}
            
            <p class="font-special-ui text-sm text-secondary-color mt-2 uppercase">// INST: {edu.institution}</p>
          </div>
          
          <div class="text-left md:text-right flex flex-col items-start md:items-end">
            <p class="font-special-ui text-xs text-primary-color bg-void border border-[var(--color-border-subtle)] px-2 py-1 inline-block uppercase mb-2">
              {edu.status}
            </p>
            <p class="font-special-ui text-sm text-secondary-color block uppercase tracking-widest">{edu.date}</p>
          </div>
        </div>

        {/* Prose formatting */}
        <p class="font-section-body text-primary-color leading-relaxed tracking-wider text-md mb-8 max-w-3xl">
          {edu.description}
        </p>

        {/* Dynamic metrics grid */}
        <div class="flex flex-wrap gap-x-8 gap-y-4 border-t border-[var(--color-border-subtle)] pt-6 mt-auto">
          {edu.metrics.map((metric) => (
            <div class="group/metric bg-void border border-[var(--color-border-subtle)] p-3 w-full md:w-auto min-w-[120px]">
              <p class="font-special-ui text-[10px] text-secondary-color uppercase mb-1 group-hover/metric:text-primary-color transition-colors">
                // {metric.label}
              </p>
              <p class="font-special-ui text-sm text-primary-color">{metric.value}</p>
            </div>
          ))}
        </div>

      </div>
    ))}
  </div>

</section>