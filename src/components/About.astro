---
// src/components/About.astro
import { ABOUT, ABOUT_DESCRIPTION } from '../data/about.js';

// IMPORT THE HARDWARE NODE
import HardwareNode from './ui/HardwareNode.astro';
---

<section id="about" class="bg-void flex flex-col w-full scroll-mt-24 mt-32 deploy-hidden">
  
  {/* SECTION HEADER */}
  <div class="flex items-center mb-8 w-full">
    
    <div class="relative flex items-center">
      {/* The wire shooting left to the main bus */}
      <div class="trace-connector hidden lg:block z-0"></div>
      
      {/* Hardware Node (Purple Accent) */}
      <HardwareNode class="text-accent hidden lg:block relative z-10 mr-4 bg-void" />
      
      <h2 
        class="text-4xl font-section-headers tracking-tight uppercase text-primary-color"
        data-scramble 
        data-scramble-delay="400"
      >
        {ABOUT.header}
      </h2>
    </div>

    <div class="h-[1px] flex-grow bg-[var(--color-industrial)] ml-4"></div>
    <p class="font-special-ui text-sm text-secondary-color uppercase ml-4">
      ID: {ABOUT.sys_id}
    </p>
    
  </div>

  {/* DYNAMIC CONTEXT PARAGRAPH (Strictly acrnm-grn) */}
  <p class="font-section-description text-acrnm-grn tracking-widest leading-relaxed mb-8 w-full">
    {ABOUT_DESCRIPTION}
  </p>

  {/* MAIN CONTAINER (Sharp hardware edges, updated border tokens) */}
  <div class="bg-surface border border-[var(--color-border-subtle)] p-8 group relative hover:border-accent transition-all duration-300 overflow-hidden">
    
    {/* FILM GRAIN LAYER: Oversized to hide the jitter edges */}
    <div class="absolute -inset-[10%] w-[120%] h-[120%] pointer-events-none z-0 opacity-[0.04] animate-noise">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="w-full h-full" preserveAspectRatio="none">
        <filter id="aboutNoiseFilter">
          <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"/>
        </filter>
        <rect width="100%" height="100%" filter="url(#aboutNoiseFilter)"/>
      </svg>
    </div>

    {/* Subtle Purple background glow on hover */}
    <div class="absolute inset-0 bg-accent/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-0"></div>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 relative z-10">
      
      {/* LEFT COLUMN: ORIGIN STORY */}
      <div class="lg:col-span-2 flex flex-col gap-6">
        <div class="flex items-center gap-3 mb-2">
          {/* FUNCTIONAL: Replaced manual shadow div with global status-dot utility */}
          <div class="status-dot status-dot--accent"></div>
          <p class="font-special-ui text-sm text-accent tracking-widest uppercase">
            // [ ORIGIN_STORY ]
          </p>
        </div>
        
        <div class="flex flex-col gap-4">
          {ABOUT.background.map((paragraph) => (
            <p class="font-section-body text-primary-color leading-relaxed text-md tracking-wide">
              {paragraph}
            </p>
          ))}
        </div>
      </div>

      {/* RIGHT COLUMN: OFFLINE METRICS */}
      <div class="flex flex-col gap-6 lg:border-l lg:border-[var(--color-border-subtle)] lg:pl-8">
        {/* FUNCTIONAL: Telemetry Blue/Slate for secondary tracking data */}
        <p class="font-special-ui text-sm text-secondary-color tracking-widest uppercase mb-2">
          // [ OFFLINE_METRICS ]
        </p>
        
        <div class="flex flex-col gap-4">
          {ABOUT.offline_metrics.map((metric) => (
            <div class="border-b border-[var(--color-industrial)] pb-4 last:border-0 group/metric">
              <p class="font-special-ui text-xs text-secondary-color uppercase mb-1 group-hover/metric:text-accent transition-colors">
                {metric.category}
              </p>
              <p class="font-section-body text-sm text-primary-color leading-relaxed">
                {metric.details}
              </p>
            </div>
          ))}
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  /* The jitter animation for the film grain */
  @keyframes noise-dance {
    0%, 100% { transform: translate(0, 0); }
    10% { transform: translate(-1%, -1%); }
    30% { transform: translate(1%, 1%); }
    50% { transform: translate(-0.5%, 0.5%); }
    70% { transform: translate(1.5%, -1.5%); }
    90% { transform: translate(-1%, 1%); }
  }

  .animate-noise {
    animation: noise-dance 0.4s steps(2) infinite;
  }
</style>