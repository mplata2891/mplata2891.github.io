---
// src/components/LabArchive.astro
import { LABS, LABS_DESCRIPTION } from '../data/labs.js';
import LabCard from './section-cards/LabCard.astro';
import SysCarousel from './system/SysCarousel.astro';
import HardwareNode from './ui/HardwareNode.astro';
---

<section id="lab" class="flex flex-col w-full scroll-mt-24 mb-16 deploy-hidden">
  
  {/* SECTION HEADER */}
  <div class="flex items-center mb-4 w-full">
    
    <div class="relative flex items-center">
      <div class="trace-connector hidden lg:block z-0"></div>
      {/* Swapped text-accent for text-secondary-color to match the Light Zone palette */}
      <HardwareNode class="text-secondary-color hidden lg:block relative z-10 mr-4 bg-void" />
      
      {/* FIXED: Swapped font-section-description to font-section-headers (Space Grotesk) */}
      <h2 class="text-4xl font-section-headers tracking-tight uppercase text-primary-color">
        LAB ARCHIVE
      </h2>
    </div>

    <div class="h-[1px] flex-grow bg-[var(--color-border-subtle)] ml-4"></div>
    <p class="font-special-ui text-sm text-secondary-color uppercase ml-4">
      Execution_Logs_v5.0
    </p>
    
  </div>

  {/* DYNAMIC CONTEXT PARAGRAPH */}
  {/* FIXED: Replaced acrnm-nvy with secondary-color */}
  <p class="font-section-description text-secondary-color leading-relaxed tracking-wider mb-8 w-full">
    {LABS_DESCRIPTION}
  </p>

  {/* CAROUSEL */}
  <SysCarousel>
    {LABS.map((lab) => (
      <div class="w-full md:w-[85%] flex-shrink-0 snap-center flex flex-col h-full py-4 pl-4 pr-6">
        {/* Added some padding to the wrapper so the brutalist box shadow doesn't get clipped by the carousel overflow */}
        <LabCard lab={lab} />
      </div>
    ))}
  </SysCarousel>

</section>